{
  "schemaVersion": 1,
  "id": "project.coal.tee",
  "version": "1.0.0",
  "requiredRoles": {
    "root": {
      "required": true,
      "cardinality": "one",
      "capabilities": []
    },
    "on1": {
      "required": true,
      "cardinality": "one",
      "capabilities": []
    },
    "on2": {
      "required": true,
      "cardinality": "one",
      "capabilities": []
    },
    "on3": {
      "required": true,
      "cardinality": "one",
      "capabilities": []
    },
    "off1": {
      "required": true,
      "cardinality": "one",
      "capabilities": []
    },
    "off2": {
      "required": true,
      "cardinality": "one",
      "capabilities": []
    },
    "off3": {
      "required": true,
      "cardinality": "one",
      "capabilities": []
    }
  },
  "listens": [
    "coal:device:update",
    "coal:device:ready",
    "coal:device:ack"
  ],
  "writes": [
    "on1.visible",
    "on2.visible",
    "on3.visible",
    "off1.visible",
    "off2.visible",
    "off3.visible"
  ],
  "state": [
    "unknown",
    "stopped",
    "running"
  ],
  "invariants": [
    "Full snapshot replacement clears omitted values",
    "State and disposal are scoped to the mounted instance"
  ],
  "requiredEvidence": [
    "role-binding-compatible",
    "script-mounted",
    "instance-isolation",
    "rendered-output"
  ]
}
