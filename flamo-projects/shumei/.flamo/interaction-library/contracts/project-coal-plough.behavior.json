{
  "schemaVersion": 1,
  "id": "project.coal.plough",
  "version": "1.0.0",
  "requiredRoles": {
    "root": {
      "required": true,
      "cardinality": "one",
      "capabilities": []
    },
    "parts1": {
      "required": true,
      "cardinality": "one",
      "capabilities": []
    },
    "parts2": {
      "required": true,
      "cardinality": "one",
      "capabilities": []
    },
    "parts3": {
      "required": true,
      "cardinality": "one",
      "capabilities": []
    }
  },
  "listens": [
    "coal:device:update",
    "coal:device:ready",
    "coal:device:ack"
  ],
  "writes": [
    "parts1.visible",
    "parts2.visible",
    "parts3.visible"
  ],
  "state": [
    "unknown",
    "stopped",
    "running"
  ],
  "invariants": [
    "Full snapshot replacement clears omitted values",
    "State and disposal are scoped to the mounted instance"
  ],
  "requiredEvidence": [
    "role-binding-compatible",
    "script-mounted",
    "instance-isolation",
    "rendered-output"
  ]
}
