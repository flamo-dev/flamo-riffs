{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "/vendor/flamo-runtime/*": [
        "view/api/flamo-runtime.d.ts"
      ],
      "@flamo/interaction-library/*": [
        "src/.flamo/interaction-library/*"
      ]
    },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "view/**/*.d.ts",
    "src/**/*"
  ]
}
